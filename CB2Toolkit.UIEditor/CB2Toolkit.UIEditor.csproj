<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0-windows</TargetFramework>
        <Nullable>enable</Nullable>
        <UseWPF>true</UseWPF>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup>
      <Page Update="Views\UIEditorView.xaml">
        <Generator>MSBuild:Compile</Generator>
        <XamlRuntime>Wpf</XamlRuntime>
        <SubType>Designer</SubType>
      </Page>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\CB2Toolkit.CodeEditor\CB2Toolkit.CodeEditor.csproj" />
      <ProjectReference Include="..\CB2Toolkit.Core\CB2Toolkit.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Fonts\" />
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Include="Fonts\Andale Mono.ttf" />
      <EmbeddedResource Include="Fonts\Courier New.ttf" />
      <EmbeddedResource Include="Fonts\Courier Prime.ttf" />
      <EmbeddedResource Include="Fonts\DS-Digital.TTF" />
      <EmbeddedResource Include="Fonts\Icons.ttf" />
      <EmbeddedResource Include="Fonts\Journal.ttf" />
      <EmbeddedResource Include="Fonts\LektonCode-Regular.ttf" />
      <EmbeddedResource Include="Fonts\OPPOSans-M.ttf" />
      <EmbeddedResource Include="Fonts\tahoma.ttf" />
    </ItemGroup>

</Project>
